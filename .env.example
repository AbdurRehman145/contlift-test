# Supabase project (Dashboard → Project Settings → API Keys)
SUPABASE_URL=https://your-project.supabase.co
# Server-only key. Never expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Shared secret that publishers (Contlify, Postman, n8n, ...) send as X-Contlify-Key
CONTLIFY_API_KEY=change-me

# Production only: comma-separated hostnames the SSR server will answer for
# NG_ALLOWED_HOSTS=blog.example.com
